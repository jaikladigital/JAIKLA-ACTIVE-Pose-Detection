rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // User Profile & Calibration Data
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 100;
      allow delete: if isOwner(userId);
    }

    // Workout Sessions
    match /workouts/{sessionId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
        && isValidId(sessionId)
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.exerciseType is string
        && request.resource.data.exerciseType.size() <= 50
        && request.resource.data.repsCount is number
        && request.resource.data.avgAccuracy is number
        && request.resource.data.durationSeconds is number;
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Motion Clips (Before / After Comparison)
    match /motionClips/{clipId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
        && isValidId(clipId)
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.exerciseType is string
        && request.resource.data.category in ['before', 'after', 'practice']
        && request.resource.data.accuracyScore is number;
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
